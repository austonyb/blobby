# Copy this file to .env.local and fill in values from your Vercel Blob store.
# Dashboard: Project → Storage → Blob
# Do not commit .env.local.

# Required locally for list/upload/delete and for client-token uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Store id from the Blob dashboard (store_...)
BLOB_STORE_ID=store_...

# Store base URL from the dashboard, e.g. https://<id>.private.blob.vercel-storage.com
BLOB_STORE_URL=https://xxxx.private.blob.vercel-storage.com

# Access is private (locked in code). Previews stream through /api/blob/file.

# Signs login cookies. Falls back to BLOB_READ_WRITE_TOKEN if unset.
# openssl rand -base64 32
AUTH_SECRET=
